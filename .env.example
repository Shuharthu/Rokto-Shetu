# =====================================================================
# RoktoSetu Environment Configuration Template (DUMMY VALUES ONLY)
# NEVER COMMIT REAL API KEYS, TOKENS, OR SERVICE ACCOUNT KEYS
# =====================================================================

# Environment Mode: development | staging | production
NODE_ENV=development

# Firebase Web Client Configuration (Public by design; secured via App Check & Rules)
FIREBASE_API_KEY=dummy_firebase_api_key_for_development_only
FIREBASE_AUTH_DOMAIN=roktosetu-dev.firebaseapp.com
FIREBASE_PROJECT_ID=roktosetu-dev
FIREBASE_STORAGE_BUCKET=roktosetu-dev.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-DUMMY12345

# App Check (reCAPTCHA Enterprise)
RECAPTCHA_ENTERPRISE_SITE_KEY=6Ld_dummySiteKeyEnterprise_1234567890abcdef

# Firebase Emulator Hosts (Local Development)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Google Cloud KMS Key Resource (For PII & NID Encryption)
KMS_KEY_NAME=projects/roktosetu-dev/locations/asia-south1/keyRings/roktosetu-keyring/cryptoKeys/pii-encryption-key
KMS_FALLBACK_SECRET=dev_local_mock_symmetric_key_32_bytes_len!!

# Payment Gateways (Cloud Functions Server-Side Webhooks Only)
BKASH_APP_KEY=dummy_bkash_app_key
BKASH_APP_SECRET=dummy_bkash_app_secret
BKASH_USERNAME=dummy_bkash_user
BKASH_PASSWORD=dummy_bkash_pass
BKASH_WEBHOOK_SECRET=dummy_bkash_hmac_secret_key

SSLCOMMERZ_STORE_ID=dummy_store_id
SSLCOMMERZ_STORE_PASSWD=dummy_store_passwd
SSLCOMMERZ_IS_SANDBOX=true

STRIPE_SECRET_KEY=sk_test_dummyStripeSecretKey1234567890
STRIPE_WEBHOOK_SECRET=whsec_dummyStripeWebhookSecret12345

# Communication Providers (Cloud Functions Server-Side Only)
TWILIO_ACCOUNT_SID=ACdummyTwilioAccountSid1234567890
TWILIO_AUTH_TOKEN=dummyTwilioAuthToken1234567890
TWILIO_PHONE_NUMBER=+15005550006

POSTMARK_SERVER_TOKEN=dummy-postmark-server-token-12345
SYSTEM_FROM_EMAIL=support@roktosetu.org

# Platform Operations & Limits
DEFAULT_DONATION_GAP_DAYS_MALE=90
DEFAULT_DONATION_GAP_DAYS_FEMALE=120
MAX_ACTIVE_FUNDRAISERS_PER_PATIENT=1
MAX_ACTIVE_FUNDRAISERS_PER_APPLICANT=2
