rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================================================
    // GLOBAL SECURITY HELPER FUNCTIONS
    // ===================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasCustomClaim(claim) {
      return isAuthenticated() && request.auth.token[claim] == true;
    }

    function isSuperAdmin() {
      return hasCustomClaim('super_admin');
    }

    function isAdmin() {
      return isSuperAdmin() || hasCustomClaim('admin');
    }

    function isModerator() {
      return isAdmin() || hasCustomClaim('moderator');
    }

    function isIdentityVerifier() {
      return isAdmin() || hasCustomClaim('identity_verifier');
    }

    function isFundraiserReviewer() {
      return isAdmin() || hasCustomClaim('fundraiser_reviewer') || hasCustomClaim('senior_reviewer');
    }

    function isFinanceApprover() {
      return isAdmin() || hasCustomClaim('finance_approver');
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && request.auth.token.orgId == orgId;
    }

    function isOrgRole(orgId, role) {
      return isOrgMember(orgId) && (request.auth.token.orgRole == role || request.auth.token.orgRole == 'owner');
    }

    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.verified == true;
    }

    // Prevents tampering with protected system fields on client writes
    function unaffected(fieldList) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fieldList);
    }

    // Default catch-all: Deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // ===================================================================
    // 1. USERS & IDENTITY
    // ===================================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.verificationStatus == 'pending'
                    && (!('roles' in request.resource.data) || request.resource.data.roles == []);
      allow update: if isOwner(userId)
                    && unaffected(['uid', 'roles', 'verificationStatus', 'isDonor', 'profileCompletion'])
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /users_private/{userId} {
      allow read: if isOwner(userId) || isIdentityVerifier();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && unaffected(['encryptedNID', 'idNumberHash']) || isIdentityVerifier();
      allow delete: if isAdmin();
    }

    match /identity_docs/{docId} {
      allow read: if isIdentityVerifier();
      allow write: if false; // Uploads registered via Cloud Functions
    }

    match /id_hash_index/{hashId} {
      allow read, write: if false; // Managed exclusively by Cloud Functions
    }

    // ===================================================================
    // 2. DONORS & AVAILABILITY
    // ===================================================================

    match /donors/{donorId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(donorId);
      allow update: if isOwner(donorId)
                    && unaffected(['totalDonations', 'level', 'badgeUrl', 'points', 'isEligible', 'nextEligibleDate'])
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /availability/{donorId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(donorId);
      allow delete: if isOwner(donorId) || isAdmin();
    }

    // ===================================================================
    // 3. SEEKER REQUESTS & MATCHING
    // ===================================================================

    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isVerifiedUser() && request.resource.data.seekerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.seekerId == request.auth.uid
                        && unaffected(['seekerId', 'createdAt', 'verificationCode']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /request_matches/{matchId} {
      allow read: if isAuthenticated() && (resource.data.donorId == request.auth.uid || resource.data.seekerId == request.auth.uid || isAdmin());
      allow create: if false; // Created by Cloud Function Matching Engine
      allow update: if isAuthenticated() && resource.data.donorId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if isAuthenticated() && (resource.data.donorId == request.auth.uid || resource.data.seekerId == request.auth.uid || isAdmin());
      allow write: if false; // Recorded strictly by Cloud Function donation verification
    }

    // ===================================================================
    // 4. GAMIFICATION & REWARDS
    // ===================================================================

    match /levels_config/{levelId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_rewards/{rewardId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Generated strictly via Cloud Function
    }

    // ===================================================================
    // 5. IN-APP CHATS & NOTIFICATIONS
    // ===================================================================

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isModerator();
      }
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow write: if false;
    }

    // ===================================================================
    // 6. B2B ORGANIZATIONS & BLOOD INVENTORY
    // ===================================================================

    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId) || isAdmin();
      allow create: if isSuperAdmin();
      allow update: if isOrgRole(orgId, 'owner') && unaffected(['planId', 'subscriptionStatus']) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /org_members/{memberId} {
      allow read: if isAuthenticated() && (resource.data.orgId == request.auth.token.orgId || isAdmin());
      allow write: if false; // Synced with custom claims via Cloud Functions
    }

    match /org_branches/{branchId} {
      allow read: if isOrgMember(resource.data.orgId) || isAdmin();
      allow create: if isOrgRole(request.resource.data.orgId, 'manager');
      allow update, delete: if isOrgRole(resource.data.orgId, 'manager') || isAdmin();
    }

    match /inventory_units/{unitId} {
      allow read: if isOrgMember(resource.data.orgId) || isAdmin();
      allow create: if isOrgMember(request.resource.data.orgId)
                    && (request.auth.token.orgRole in ['owner', 'manager', 'inventory_staff']);
      allow update: if isOrgMember(resource.data.orgId)
                    && (request.auth.token.orgRole in ['owner', 'manager', 'inventory_staff'])
                    && unaffected(['orgId', 'unitId']);
      allow delete: if isOrgRole(resource.data.orgId, 'manager') || isAdmin();
    }

    match /inventory_events/{eventId} {
      allow read: if isOrgMember(resource.data.orgId) || isAdmin();
      allow create: if isOrgMember(request.resource.data.orgId);
      allow update, delete: if false; // Events are immutable append-only
    }

    match /camps/{campId} {
      allow read: if true;
      allow create: if isOrgMember(request.resource.data.orgId)
                    && (request.auth.token.orgRole in ['owner', 'manager', 'coordinator']);
      allow update, delete: if isOrgMember(resource.data.orgId)
                    && (request.auth.token.orgRole in ['owner', 'manager', 'coordinator']) || isAdmin();
    }

    match /camp_rsvps/{rsvpId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOrgMember(resource.data.orgId) || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                    || (isOrgMember(resource.data.orgId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'checkedInAt']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ===================================================================
    // 7. B2B BILLING, PLANS & API KEYS
    // ===================================================================

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isOrgRole(resource.data.orgId, 'owner') || isAdmin();
      allow write: if false; // Updated strictly via verified billing webhooks
    }

    match /invoices/{invId} {
      allow read: if isOrgRole(resource.data.orgId, 'owner') || isAdmin();
      allow write: if false;
    }

    match /api_keys/{keyId} {
      allow read: if isOrgRole(resource.data.orgId, 'owner') || isAdmin();
      allow write: if false; // Created/rotated strictly via Cloud Functions
    }

    match /webhooks/{webhookId} {
      allow read, write: if isOrgRole(resource.data.orgId, 'owner') || isAdmin();
    }

    // ===================================================================
    // 8. CRITICAL PATIENT FUNDRAISER ENGINE
    // ===================================================================

    match /fundraisers/{fundraiserId} {
      allow read: if isAuthenticated() && (resource.data.applicantId == request.auth.uid || isFundraiserReviewer());
      allow create: if isVerifiedUser() && request.resource.data.applicantId == request.auth.uid
                    && request.resource.data.status == 'draft'
                    && request.resource.data.raisedAmountBDT == 0;
      allow update: if (isAuthenticated() && resource.data.applicantId == request.auth.uid
                        && resource.data.status in ['draft', 'needs_more_info']
                        && unaffected(['applicantId', 'status', 'raisedAmountBDT', 'donorCount']))
                    || isFundraiserReviewer();
      allow delete: if false;
    }

    match /public_fundraisers/{campaignId} {
      allow read: if true;
      allow write: if false; // Sanitized public projection generated ONLY by Cloud Functions
    }

    match /fundraiser_patients/{patientId} {
      allow read: if isAuthenticated() && (resource.data.applicantId == request.auth.uid || isFundraiserReviewer());
      allow create, update: if isAuthenticated() && request.resource.data.applicantId == request.auth.uid;
      allow delete: if false;
    }

    match /fundraiser_documents/{docId} {
      allow read: if isAuthenticated() && (resource.data.applicantId == request.auth.uid || isFundraiserReviewer());
      allow create: if isAuthenticated() && request.resource.data.applicantId == request.auth.uid;
      allow update, delete: if isFundraiserReviewer();
    }

    match /fundraiser_donations/{donationId} {
      allow read: if isAuthenticated() && (resource.data.donorUserId == request.auth.uid || isFinanceApprover());
      allow write: if false; // Populated only via server-side payment webhooks
    }

    match /ledger_entries/{entryId} {
      allow read: if isFinanceApprover();
      allow write: if false; // Append-only double-entry ledger created strictly via Cloud Functions
    }

    match /fundraiser_payout_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.applicantId == request.auth.uid || isFinanceApprover());
      allow create: if isAuthenticated() && request.resource.data.applicantId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isFinanceApprover();
      allow delete: if false;
    }

    match /fundraiser_proofs/{proofId} {
      allow read: if isAuthenticated() && (resource.data.applicantId == request.auth.uid || isFundraiserReviewer());
      allow create: if isAuthenticated() && request.resource.data.applicantId == request.auth.uid;
      allow update: if isFundraiserReviewer();
      allow delete: if false;
    }

    // ===================================================================
    // 9. PLATFORM ADMIN, AUDIT, REPORTS & SETTINGS
    // ===================================================================

    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isModerator();
      allow delete: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Immutable audit logs created strictly via Cloud Functions
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /feature_flags/{flagId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blood_banks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin() || hasCustomClaim('content_editor');
    }
  }
}
